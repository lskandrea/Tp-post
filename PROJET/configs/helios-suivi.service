[Unit]
Description=Helios - portail de suivi des tournees
After=network.target helios-suivi-publish.service
Wants=helios-suivi-publish.service
PartOf=helios.target

[Service]
Type=simple
User=helios-suivi
Group=suivi
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 0.0.0.0 --directory /srv/helios/suivi/www
Restart=always
RestartSec=2s
MemoryMax=128M
CPUQuota=50%
CPUAccounting=yes
MemoryAccounting=yes
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/tmp /var/tmp /dev/shm /dev/mqueue
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes

[Install]
WantedBy=helios.target
