[Unit]
Description=Helios - publication atomique de la telemetrie
After=helios-collect.service

[Service]
Type=oneshot
User=helios-suivi
Group=suivi
ExecStart=/usr/local/sbin/helios-suivi-publish.sh
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/helios/suivi/www
ProtectHome=yes
PrivateTmp=no
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=

